function clean(text) {
    return text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[’‘'`]/g, '').replace(/[^a-z0-9* ]+/g, ' ').replace(/^the /, '').replace(/\s+/g, ' ').trim();
}

function distance(a, b) {
    const row = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
        let prev = row[0];
        row[0] = i;
        for (let j = 1; j <= b.length; j++) {
            const temp = row[j];
            row[j] = Math.min(row[j] + 1, row[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
            prev = temp;
        }
    }
    return row[b.length];
}

const SpaceDB = {
    categories: SPACE_CATEGORIES,
    items: SPACE_ITEMS,

    get(id) {
        return SPACE_ITEMS.find((item) => item.id === id) || null;
    },

    category(id) {
        return SPACE_CATEGORIES.find((cat) => cat.id === id) || null;
    },

    byCategory(catId) {
        if (!catId || catId === 'all') return SPACE_ITEMS.slice();
        return SPACE_ITEMS.filter((item) => item.cat === catId);
    },

    count(catId) {
        return this.byCategory(catId).length;
    },

    search(text, catId) {
        const q = text.trim().toLowerCase();
        const pool = this.byCategory(catId);
        if (!q) return pool;
        return pool.filter((item) => {
            const haystack = [item.name, item.type, item.summary, ...item.facts, ...Object.values(item.stats)].join(' ').toLowerCase();
            return haystack.includes(q);
        });
    },

    suggest(text, limit = 7) {
        const q = clean(text);
        if (!q) return [];
        const scored = SPACE_ITEMS.map((item) => {
            const name = clean(item.name);
            const words = name.split(' ');
            const cat = this.category(item.cat);
            let score = 0;
            let fuzzy = false;
            if (name === q || words.join('') === q) score = 100;
            else if (name.startsWith(q)) score = 90;
            else if (words.some((w) => w.startsWith(q))) score = 80;
            else if (name.includes(q)) score = 70;
            else if (clean(item.type).includes(q) || clean(cat.name).includes(q)) score = 50;
            else if (clean(item.summary + ' ' + item.facts.join(' ')).includes(q)) score = 30;
            else if (q.includes(' ') && q.split(' ').every((qw) => clean(item.name + ' ' + item.type + ' ' + cat.name).split(' ')
                .some((w) => w.startsWith(qw) || distance(qw, w) <= Math.max(1, Math.floor(qw.length / 3))))) {
                score = 55;
                fuzzy = true;
            } else {
                const allowed = Math.max(1, Math.floor(q.length / 3));
                const best = Math.min(distance(q, name), ...words.map((w) => distance(q, w)));
                const textWords = clean(item.summary + ' ' + item.facts.join(' ')).split(' ').filter((w) => w.length > 3);
                const textBest = Math.min(99, ...textWords.map((w) => distance(q, w)));
                const nameScore = best <= allowed ? 60 - best * 15 : 0;
                const textScore = textBest <= allowed ? 45 - textBest * 10 : 0;
                score = Math.max(nameScore, textScore);
                fuzzy = score > 0;
            }
            return { item, score, fuzzy, similar: false };
        }).filter((r) => r.score > 0).sort((a, b) => b.score - a.score || a.item.name.localeCompare(b.item.name));

        const results = scored.slice(0, limit);
        if (results.length > 0 && results.length < limit) {
            const top = results[0].item;
            SPACE_ITEMS.filter((item) => item.cat === top.cat && !results.some((r) => r.item === item))
                .slice(0, limit - results.length)
                .forEach((item) => results.push({ item, score: 0, fuzzy: false, similar: true }));
        }
        if (results.length === 0) {
            return SPACE_ITEMS.map((item) => ({ item, d: distance(q, clean(item.name)) }))
                .sort((a, b) => a.d - b.d)
                .slice(0, 5)
                .map((r) => ({ item: r.item, score: 0, fuzzy: true, similar: false }));
        }
        return results;
    },

    randomFact() {
        const item = SPACE_ITEMS[Math.floor(Math.random() * SPACE_ITEMS.length)];
        const fact = item.facts[Math.floor(Math.random() * item.facts.length)];
        return { item, fact };
    }
};
